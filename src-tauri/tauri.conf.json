{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MPN Studio",
  "version": "0.4.0",
  "identifier": "me.fylume.mpnstudio",
  "build": {
    "frontendDist": "../web/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "category": "DeveloperTool",
    "shortDescription": "MPN Studio: build, test and export MPN models",
    "longDescription": "MPN Studio builds models from a cognitive core (GGUF or Hugging Face) and a Modular Persistent Network of nodes. Create, edit, merge and test node networks, build a model, chat with it with the evidence it used, serve it through an OpenAI-compatible local API, and export it as a single .mpn file that runs with the mpn command. Everything runs on your computer, offline.",
    "copyright": "Fylume",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "resources": {
      "../build/backend/": "backend/",
      "../runtime/": "runtime/",
      "../LICENSE": "licenses/LICENSE",
      "../NOTICE": "licenses/NOTICE",
      "../THIRD-PARTY.md": "licenses/THIRD-PARTY.md",
      "../docs/THIRD-PARTY-RUST.md": "licenses/THIRD-PARTY-RUST.md"
    },
    "linux": {
      "deb": {
        "section": "science",
        "priority": "optional",
        "desktopTemplate": "../packaging/linux/mpn-studio.desktop",
        "files": {
          "/usr/share/mime/packages/mpn-studio.xml": "../packaging/linux/mpn-studio-mime.xml",
          "/usr/bin/mpn": "../packaging/linux/mpn"
        }
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "mpn"
        ],
        "name": "MPN model",
        "description": "MPN model file",
        "mimeType": "application/x-mpn-model",
        "role": "Viewer"
      },
      {
        "ext": [
          "mpnbak"
        ],
        "name": "MPN Studio backup",
        "description": "MPN Studio project backup",
        "mimeType": "application/x-mpn-studio-backup",
        "role": "Editor"
      }
    ],
    "licenseFile": "../LICENSE"
  }
}
